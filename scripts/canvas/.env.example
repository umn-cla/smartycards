# Canvas API Configuration
# Copy this file to .env and fill in your Canvas access token

# Canvas instance URL
CANVAS_BASE_URL=https://canvas.docker

# Canvas API access token (required)
# Generate this from Canvas: Account → Settings → New Access Token
CANVAS_ACCESS_TOKEN=your_canvas_access_token_here

# Canvas account ID (default is 1 for the main account)
CANVAS_ACCOUNT_ID=1

# Disable SSL certificate validation for local development with self-signed certs
# IMPORTANT: Only use this for local development, never in production!
NODE_TLS_REJECT_UNAUTHORIZED=0
