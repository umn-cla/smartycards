{
  "name": "smarty-cards-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf public/build && vite build",
    "preview": "vite build && vite preview --port 5173",
    "build-only": "vite build",
    "cy:open": "cypress open",
    "cy:headless": "cypress run --browser chrome",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "vue-tsc": "vue-tsc --noEmit --skipLibCheck",
    "cert": "./generate-cert.sh \"$@\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "npm run docs:build && vitepress preview docs",
    "docs:deploy": "npm run docs:build && gh-pages -d docs/.vitepress/dist",
    "canvas:seed": "tsx scripts/canvas/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.2.7",
    "@fontsource-variable/rokkitt": "^5.2.8",
    "@headlessui/vue": "^1.7.23",
    "@radix-icons/vue": "^1.0.0",
    "@tanstack/vue-query": "^5.100.10",
    "@umn-latis/cla-vue-template": "^2.0.1",
    "@umn-latis/quill-better-image-module": "^0.2.4",
    "@vue-a11y/announcer": "^3.1.5",
    "@vueuse/core": "^12.8.2",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "filepond": "^4.32.12",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-preview": "^4.6.12",
    "katex": "^0.16.45",
    "marked": "^15.0.12",
    "marked-katex-extension": "^5.1.8",
    "mathlive": "^0.109.2",
    "p-debounce": "^4.0.0",
    "pinia": "^2.3.1",
    "quill": "^2.0.3",
    "quill-paste-smart": "^2.0.0",
    "radix-vue": "^1.9.17",
    "ramda": "^0.32.0",
    "tiny-invariant": "^1.3.3",
    "vue": "^3.5.34",
    "vue-filepond": "^7.0.4",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tsconfig/node20": "^20.1.9",
    "@types/jszip": "^3.4.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.19.19",
    "@types/quill": "^2.0.14",
    "@types/ramda": "^0.31.1",
    "@umn-latis/vitepress-theme-umn": "^0.2.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "cypress": "^15.14.2",
    "cypress-real-events": "^1.15.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "jszip": "^3.10.1",
    "laravel-vite-plugin": "^3.1.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.14",
    "prettier": "3.8.3",
    "tailwind-merge": "^2.6.1",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.2.8"
  }
}
