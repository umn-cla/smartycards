{
  "name": "smarty-cards-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf public/build && run-p type-check \"build-only {@}\" --",
    "preview": "vite build && vite preview --port 5173",
    "build-only": "vite build",
    "cy:open": "cypress open",
    "cy:headless": "cypress run --browser chrome",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "vue-tsc": "vue-tsc --noEmit --skipLibCheck",
    "cert": "./generate-cert.sh \"$@\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "npm run docs:build && vitepress preview docs",
    "docs:deploy": "npm run docs:build && gh-pages -d docs/.vitepress/dist",
    "canvas:seed": "tsx scripts/canvas/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.2.7",
    "@fontsource-variable/rokkitt": "^5.2.8",
    "@headlessui/vue": "^1.7.23",
    "@radix-icons/vue": "^1.0.0",
    "@tanstack/vue-query": "^5.92.5",
    "@umn-latis/cla-vue-template": "^2.0.1",
    "@umn-latis/quill-better-image-module": "^0.2.2",
    "@vue-a11y/announcer": "^3.1.5",
    "@vueuse/core": "^12.8.2",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "filepond": "^4.32.11",
    "filepond-plugin-file-validate-type": "^1.2.9",
    "filepond-plugin-image-preview": "^4.6.12",
    "katex": "^0.16.27",
    "marked": "^15.0.12",
    "marked-katex-extension": "^5.1.6",
    "mathlive": "^0.108.2",
    "p-debounce": "^4.0.0",
    "pinia": "^2.3.1",
    "quill": "^2.0.3",
    "quill-paste-smart": "^2.0.0",
    "radix-vue": "^1.9.17",
    "ramda": "^0.32.0",
    "tiny-invariant": "^1.3.3",
    "uuid": "^11.1.0",
    "vue": "^3.5.26",
    "vue-filepond": "^7.0.4",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tsconfig/node20": "^20.1.8",
    "@types/jszip": "^3.4.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.19.3",
    "@types/quill": "^2.0.14",
    "@types/ramda": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "@umn-latis/vitepress-theme-umn": "^0.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.23",
    "cypress": "^14.5.4",
    "cypress-real-events": "^1.15.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "jszip": "^3.10.1",
    "laravel-vite-plugin": "^1.3.0",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.5.6",
    "prettier": "3.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^6.4.1",
    "vitepress": "^1.6.4",
    "vue-tsc": "^2.2.12"
  }
}
